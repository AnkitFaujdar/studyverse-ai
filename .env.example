# StudyVerse AI - Environment Variables
# Copy this file to .env.local and fill in your credentials

# Supabase Configuration
# Obtain from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Tutor API (Google Gemini or OpenAI)
# Optional: If not provided, StudyVerse AI provides realistic built-in academic tutoring responses and configuration banners.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
